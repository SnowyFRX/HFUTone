<?xml version="1.0" encoding="utf-8"?>
<!--
  签到成功的横幅（heads-up）。

  同样只用 RemoteViews 白名单控件：左侧那道竖条是 ImageView，不是裸 <View>。
  heads-up 弹出用的是折叠态，高度只有六十来 dp，所以最多两行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/island_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:layout_width="3dp"
        android:layout_height="30dp"
        android:layout_marginEnd="13dp"
        android:contentDescription="@null"
        android:src="@drawable/alert_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:text="已自动签到"
            android:textColor="#FCFBF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#A8A5A0"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/alert_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:text=""
        android:textColor="#7A7873"
        android:textSize="11sp" />
</LinearLayout>