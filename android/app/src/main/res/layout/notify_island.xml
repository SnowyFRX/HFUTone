<?xml version="1.0" encoding="utf-8"?>
<!--
  签到守护的「灵动岛」布局。

  RemoteViews 只认白名单里的控件：LinearLayout / TextView / ImageView / ...
  **不能**用裸 <View>，那不是白名单控件，解析时会抛异常——表现就是通知能显示、
  一点就崩。圆点因此改用 ImageView（setImageViewResource 设 src）。

  折叠态通知高度固定（约 64dp），所以只放一行：左圆点、中间两行、右侧数字。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/island_bg"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/island_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:src="@drawable/island_dot_ok" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/island_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:text="签到守护"
            android:textColor="#FCFBF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/island_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="正在连接…"
            android:textColor="#A8A5A0"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/island_tail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text=""
        android:textColor="#7A7873"
        android:textSize="11sp" />
</LinearLayout>